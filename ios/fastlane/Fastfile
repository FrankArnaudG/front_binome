default_platform(:ios)

platform :ios do
  desc "Build l'app (via flutter build ios), signe avec match, publie sur TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    # readonly: true (voir Matchfile) — la CI ne crée/modifie jamais les
    # certificats, elle les récupère seulement. Les générer/renouveler se
    # fait à la main en local (ou ponctuellement en CI avec readonly:false,
    # voir instructions).
    match(type: "appstore", api_key: api_key)

    # `flutter build ios` (voir workflow CI) a déjà généré
    # ios/Runner.xcworkspace avec les pods installés — gym se charge
    # uniquement de l'archive + l'export signé.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.binome.app" => "match AppStore com.binome.app",
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
