default_platform(:ios)

platform :ios do
  desc "Build l'app (via flutter build ios), signe avec match, publie sur TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    # readonly: true par défaut (voir Matchfile) — la CI ne crée/modifie
    # jamais les certificats, elle les récupère seulement. Pour régénérer
    # ponctuellement (ex. certificat corrompu, renouvellement), déclencher
    # le workflow avec l'input `fix_certs: true`, qui positionne
    # MATCH_READONLY=false et MATCH_FORCE=true pour cette seule run.
    match(
      type: "appstore",
      api_key: api_key,
      readonly: ENV["MATCH_READONLY"] != "false",
      force: ENV["MATCH_FORCE"] == "true",
    )

    # match configure le profil de provisioning mais pas le Development
    # Team du projet Xcode lui-même — sans ça, xcodebuild archive échoue
    # avec "Signing for 'Runner' requires a development team".
    update_project_team(
      path: "Runner.xcodeproj",
      teamid: ENV["TEAM_ID"],
    )

    # match nomme le profil dynamiquement (ex. "match AppStore
    # com.binome.app 1793801892" — un suffixe peut être ajouté en cas de
    # régénération/collision), jamais en dur : on relit le nom exact via
    # la variable d'environnement que match vient de positionner.
    profile_name = ENV["sigh_com.binome.app_appstore_profile-name"]

    # `flutter build ios` (voir workflow CI) a déjà généré
    # ios/Runner.xcworkspace avec les pods installés — gym se charge
    # uniquement de l'archive + l'export signé.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.binome.app" => profile_name,
        },
      },
      # Le template Flutter configure la signature en "Automatic" par
      # défaut — sans ça, xcodebuild ignore le profil fourni par match et
      # cherche à générer/trouver un profil lui-même (échoue en CI).
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
