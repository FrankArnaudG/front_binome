default_platform(:ios)

platform :ios do
  desc "Récupère le certificat/profil match et configure la signature manuelle du projet"
  lane :sign do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    # readonly: true par défaut (voir Matchfile) — la CI ne crée/modifie
    # jamais les certificats, elle les récupère seulement. Pour régénérer
    # ponctuellement (ex. certificat corrompu, renouvellement), déclencher
    # le workflow avec l'input `fix_certs: true`, qui positionne
    # MATCH_READONLY=false et MATCH_FORCE=true pour cette seule run.
    match(
      type: "appstore",
      api_key: api_key,
      readonly: ENV["MATCH_READONLY"] != "false",
      force: ENV["MATCH_FORCE"] == "true",
    )

    # match nomme le profil dynamiquement (ex. "match AppStore
    # com.binome.app 1793801892" — un suffixe peut être ajouté en cas de
    # régénération/collision), jamais en dur : on relit le nom exact via
    # la variable d'environnement que match vient de positionner.
    profile_name = ENV["sigh_com.binome.app_appstore_profile-name"]

    # Configure la signature manuelle (Team, certificat, profil) UNIQUEMENT
    # sur la target 'Runner' de Runner.xcodeproj. Important : ne pas passer
    # ça en xcargs global à build_app, ça s'appliquerait à TOUT le build
    # (y compris Pods.xcodeproj) et ferait échouer les pods tiers qui
    # n'acceptent pas de profil de provisioning (ex. ScreenProtectorKit,
    # flutter_pcm_sound, flutter_secure_storage).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"],
    )

    # Écrit l'ExportOptions.plist que `flutter build ipa` utilisera (étape
    # CI séparée — voir .github/workflows/ios.yml). On ne passe plus par
    # fastlane/gym pour compiler : gym enveloppe xcodebuild dans son
    # propre process et sa sortie masque toute la phase "Run Script"
    # (compilation Dart) jusqu'à sa fin. `flutter build ipa` --verbose
    # affiche sa progression en direct, ce qui manquait totalement pour
    # diagnostiquer un run resté bloqué 6h sans la moindre sortie.
    File.write("../ExportOptions.plist", <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>#{ENV['TEAM_ID']}</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>com.binome.app</key>
          <string>#{profile_name}</string>
        </dict>
      </dict>
      </plist>
    PLIST
  end

  desc "Publie l'IPA déjà compilé (par `flutter build ipa`) sur TestFlight"
  lane :publish do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )

    upload_to_testflight(
      api_key: api_key,
      # flutter build ipa écrit dans <racine du repo>/build/ios/ipa/, pas
      # dans ios/build/... — depuis ios/fastlane/, il faut remonter de 2.
      ipa: Dir.glob("../../build/ios/ipa/*.ipa").first,
      skip_waiting_for_build_processing: true,
    )
  end
end
